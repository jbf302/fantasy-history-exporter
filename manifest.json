{
  "manifest_version": 3,
  "name": "Fantasy History Exporter",
  "short_name": "Fantasy History Exporter",
  "version": "0.2.0",
  "description": "Download your Yahoo, ESPN, or Sleeper fantasy football league's full history (standings, drafts, matchups, lineups) as a JSON file. Unofficial; not affiliated with Yahoo, ESPN, or Sleeper.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "declarativeNetRequest"],
  "host_permissions": [
    "https://football.fantasysports.yahoo.com/*",
    "https://fantasysports.yahooapis.com/*",
    "https://pub-api-ro.fantasysports.yahoo.com/*",
    "https://pub-api-rw.fantasysports.yahoo.com/*",
    "https://fantasy.espn.com/*",
    "https://lm-api-reads.fantasy.espn.com/*",
    "https://sleeper.com/*",
    "https://api.sleeper.app/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "action": {
    "default_title": "Fantasy History Exporter",
    "default_icon": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
  },
  "icons": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://football.fantasysports.yahoo.com/*"],
      "js": ["content/yahoo-detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://fantasy.espn.com/*"],
      "js": ["content/espn-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
